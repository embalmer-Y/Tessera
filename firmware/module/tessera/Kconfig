	int "Host heartbeat miss limit (periods) before link-loss"
	default 6
	help
	  Source: DEC-22 (~6s at default period).

config TS_NET_HB_RECOVER
	int "Consecutive host heartbeats required to re-declare link up"
	default 2
	help
	  Source: DEC-27 (hysteresis).

config TS_NET_PUBQ_DEPTH
	int "Publish queue depth (drop-oldest when full)"
	default 8
	help
	  Source: DEC-27 (LLD-ts-net §7).

config TS_NET_TELEM_INTERVAL_MS
	int "Periodic telemetry snapshot interval in ms"
	default 200
	help
	  Source: DEC-27. Consumed by telemetry merge (M3a.2).

config TS_NET_OPEN_BUDGET_MS
	int "Blocking open() watchdog grace budget in ms"
	default 15000
	help
	  Source: DEC-64(1) (R1 reconnect hardening, 2026-10-17). Session open
	  to a dead router (TCP connect SYN/ARP timeout + TLS handshake +
	  session declarations) can block longer than the NET feed period;
	  the grace window suppresses overdue patrol while the budget lasts
	  and expires back to fail-safe. Observed single-attempt failure time
	  2-5s; 15000ms = ~3x margin. Core clamps any grace at 60s.

config TS_NET_LEASE_TTL_MS
	int "Control lease TTL in ms (lazy expiry on access)"
	default 10000
	help
	  Source: DEC-41 (~link-loss window 6s x1.5 + margin). Lease gates
	  command admission only; never couples to safety states.

config TS_NET_IDEM_CACHE
	int "Idempotent reply cache depth (fixed LRU)"
	default 4
	help
	  Source: DEC-40. Same idem replays the cached reply without
	  re-executing the command (safe retry after network timeout).

config TS_NET_APP_CHUNK_MAX
	int "Max app-chunk payload bytes (deploy upload)"
	default 2048
	help
	  Source: LLD-agent-deploy-net 3 (2KB default, 4KB ceiling from NeuroLink field data).
	  Also sizes the zenoh query request buffer (chunk + envelope margin).

config TS_NET_PUBLISH_MAX_BYTES
	int "Max av chunk payload bytes (ts_net_publish native)"
	default 1024
	help
	  Source: DEC-47 2 (av-transport): chunks stay <=1KB so zenoh-pico
	  never enters its fragmentation path (Z_BATCH_UNICAST_SIZE=2048).

config TS_NET_PUBLISH_MIN_GAP_MS
	int "Pacing between av chunk puts in ms (avq flush)"
	default 4
	help
	  Source: DEC-47 2: >=4ms pacing measured mandatory (back-to-back
	  z_put fails with -100, errno=0, before reaching the syscall layer).

config TS_NET_PUBLISH_RETRY_MAX
	int "Av chunk publish retries per chunk (avq flush)"
	default 5
	help
	  Source: DEC-47 2 (av-transport field data).

config TS_NET_PUBLISH_RETRY_DELAY_MS
	int "Delay between av chunk retries in ms"
	default 20
	help
	  Source: DEC-47 2 (av-transport field data; <=5x20ms recovers
	  from WiFi-degraded BLOCK drops).

config TS_NET_AVQ_DEPTH
	int "Av chunk queue depth (entries of MAX_BYTES+48)"
	default 4
	help
	  Backpressure surface: APP publishing faster than the paced drain
