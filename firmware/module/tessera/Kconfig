# Tessera framework module Kconfig（子系统按 design/LLD-* 逐里程碑加入）。

menu "Tessera framework"

config TS_MODULE
	bool "Tessera framework module present"
	default y
	help
	  Build marker set automatically when the tessera module is wired
	  into the Zephyr build (ZEPHYR_EXTRA_MODULES / west manifest).
	  Source: M0 skeleton (design/HLD-firmware-framework.md §7 M0).

config TS_CORE
	bool "ts-core: boot orchestration / event bus / time / WDT framework"
	depends on TS_MODULE
	default y
	help
	  design/LLD-ts-core.md (M1).

if TS_CORE

config TS_CORE_EVT_QUEUE_DEPTH
	int "ISR event post queue depth"
	default 16
	help
	  Source: DEC-27 (LLD-ts-core §4/§6).

config TS_CORE_MAX_SUBS
	int "Max subscribers per event type"
	default 4
	help
	  Source: DEC-27 (LLD-ts-core §4/§6). Registry full = TS_E_NOMEM at init.

config TS_TEST
	bool "Test build hooks (virtual clock / injection / observable fail path)"
	default n
	help
	  Enables ts_time_test_bind, ts_evt_poll_drain, ts_wdt_patrol_once and
	  non-halting ts_safety_system_fail (LLD-ts-core §3/§6, LLD-ts-safety §5).

endif # TS_CORE

config TS_SAFETY
	bool "ts-safety: output protection / three safe states / estop / fail-safe"
	depends on TS_CORE
	default y
	help
	  design/LLD-ts-safety.md (M1).

if TS_SAFETY

config TS_SAFETY_MAX_CHANNELS
	int "Output channel registry capacity"
	default 32
	help
	  Source: DEC-27 (LLD-ts-safety §2/§7).

config TS_SAFETY_AUDIT_DEPTH
	int "Commit audit ring depth"
	default 64
	help
	  Source: DEC-27 (LLD-ts-safety §4/§7). Overflow overwrites oldest and
	  counts drops (DR-07); not persisted in V1 (DEC-30-4).

endif # TS_SAFETY

config TS_STORE
	bool "ts-store: partitions / power-loss-safe meta / read-only prov / noinit / slots"
	depends on TS_CORE
	default y
	help
	  design/LLD-ts-store.md (M2a). native_sim backend = host files
	  (CONFIG_TS_STORE_SIM_DIR); real-board flash backend lands with board bring-up.

if TS_STORE

config TS_STORE_META_MAX
	int "Meta record max size (bytes)"
	default 256
	help
	  Source: DEC-27 (LLD-ts-store §7).

config TS_STORE_SLOT_SIZE
	int "APP slot partition size (bytes)"
	default 262144
	help
	  Source: DEC-23 (slot sizes are per-board configurable; native_sim baseline).

config TS_STORE_SIM_DIR
	string "native_sim backend directory (host files)"
	default "tessera_store"
	help
	  One file per partition under this relative directory (resettable in tests).

endif # TS_STORE

config TS_HAL
	bool "ts-hal: board-independent peripheral API + permission enforcement"
	depends on TS_SAFETY
	default y
	help
	  design/LLD-ts-hal.md (M2b). ts_perm_v1 grammar + ts_api_v1 + input monitor.

if TS_HAL

config TS_HAL_MAX_INSTANCES
	int "Max peripheral instances"
	default 24
	help
	  Source: DEC-27 #7 (LLD-ts-hal §6).

config TS_HAL_INPUT_POLL_MS
	int "Input poll period in ms"
	default 100
	help
	  Source: DEC-27 #14 (LLD-ts-hal §6, DR-02).

endif # TS_HAL

config TS_APPMGR
	bool "ts-appmgr: APP lifecycle / package / slot / WAMR host"
	depends on TS_STORE
	default y
	help
	  design/LLD-ts-appmgr.md (M2b). WAMR runtime binding = M2b.2.

endmenu
