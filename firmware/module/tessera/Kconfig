# Tessera framework module Kconfig（子系统按 design/LLD-* 逐里程碑加入）。

menu "Tessera framework"

config TS_MODULE
	bool "Tessera framework module present"
	default y
	help
	  Build marker set automatically when the tessera module is wired
	  into the Zephyr build (ZEPHYR_EXTRA_MODULES / west manifest).
	  Source: M0 skeleton (design/HLD-firmware-framework.md §7 M0).

config TS_CORE
	bool "ts-core: boot orchestration / event bus / time / WDT framework"
	depends on TS_MODULE
	default y
	select TASK_WDT
	help
	  design/LLD-ts-core.md (M1). TASK_WDT selected per DEC-48 (Q-28):
	  task_wdt channel as L3 backstop for the soft patrol (NULL callback
	  => auto sys_reboot on channel expiry).

if TS_CORE

config TS_WDT_NET_PERIOD_MS
	int "ts-wdt: NET source feed period (ms)"
	default 2000
	help
	  Source: DEC-48 (Q-28②). Tolerates 10x 200ms net_wq poll period.

config TS_WDT_APPMGR_PERIOD_MS
	int "ts-wdt: APPMGR source feed period (ms)"
	default 1000
	help
	  Source: DEC-48 (Q-28②). Tolerates 10x 100ms APP tick period.

config TS_WDT_SYWORK_PERIOD_MS
	int "ts-wdt: SYWORK source feed period (ms)"
	default 1000
	help
	  Source: DEC-48 (Q-28②). Fed by the patrol callback itself.

config TS_WDT_CHANNEL_MS
	int "ts-wdt: task_wdt channel timeout (ms)"
	depends on TASK_WDT
	default 5000
	help
	  Source: DEC-48 (Q-28④). Aligned with TASK_WDT_MIN_TIMEOUT; HW
	  fallback (if enabled by board) times out at MIN+DELAY ~= 10s
	  (matches TS_HARD_WDT_CAP_MS, DEC-22/27 lineage).

config TS_CORE_EVT_QUEUE_DEPTH
	int "ISR event post queue depth"
	default 16
	help
	  Source: DEC-27 (LLD-ts-core §4/§6).

config TS_CORE_MAX_SUBS
	int "Max subscribers per event type"
	default 4
	help
	  Source: DEC-27 (LLD-ts-core §4/§6). Registry full = TS_E_NOMEM at init.

config TS_TEST
	bool "Test build hooks (virtual clock / injection / observable fail path)"
	default n
	help
	  Enables ts_time_test_bind, ts_evt_poll_drain, ts_wdt_patrol_once and
	  non-halting ts_safety_system_fail (LLD-ts-core §3/§6, LLD-ts-safety §5).

endif # TS_CORE

config TS_SAFETY
	bool "ts-safety: output protection / three safe states / estop / fail-safe"
	depends on TS_CORE
	default y
	help
	  design/LLD-ts-safety.md (M1).

if TS_SAFETY

config TS_SAFETY_MAX_CHANNELS
	int "Output channel registry capacity"
	default 32
	help
	  Source: DEC-27 (LLD-ts-safety §2/§7).

config TS_SAFETY_AUDIT_DEPTH
	int "Commit audit ring depth"
	default 64
	help
	  Source: DEC-27 (LLD-ts-safety §4/§7). Overflow overwrites oldest and
	  counts drops (DR-07); not persisted in V1 (DEC-30-4).

endif # TS_SAFETY

config TS_STORE
	bool "ts-store: partitions / power-loss-safe meta / read-only prov / noinit / slots"
	depends on TS_CORE
	default y
	help
	  design/LLD-ts-store.md (M2a). native_sim backend = host files
	  (CONFIG_TS_STORE_SIM_DIR); real-board flash backend lands with board bring-up.

if TS_STORE

config TS_STORE_META_MAX
	int "Meta record max size (bytes)"
	default 256
	help
	  Source: DEC-27 (LLD-ts-store §7).

config TS_STORE_SLOT_SIZE
	int "APP slot partition size (bytes)"
	default 262144
	help
	  Source: DEC-23 (slot sizes are per-board configurable; native_sim baseline).

config TS_STORE_SIM_DIR
	string "native_sim backend directory (host files)"
	default "tessera_store"
	help
	  One file per partition under this relative directory (resettable in tests).

config TS_STORE_FLASH
	bool "ts-store: real flash backend (flash_map fixed partitions)"
	depends on FLASH_MAP
	default n
	help
	  LLD-ts-store section 2 board backend (board bring-up unit 5). Requires
	  DT fixed partitions ts_prov_part / ts_meta_part / ts_slot_a_part /
	  ts_slot_b_part / ts_noinit_part (BUILD_ASSERT-checked against
	  TS_STORE_SLOT_SIZE / META_MAX). RAM backend otherwise (native_sim/CI).

endif # TS_STORE

config TS_HAL
	bool "ts-hal: board-independent peripheral API + permission enforcement"
	depends on TS_SAFETY
	default y
	help
	  design/LLD-ts-hal.md (M2b). ts_perm_v1 grammar + ts_api_v1 + input monitor.

config TS_HAL_FS
	bool "ts-fs capability surface (ts_fs_* natives, DEC-47)"
	depends on TS_HAL
	select FILE_SYSTEM
	default n
	help
	  DEC-47 (MD1.2e): handle-less file API over a mounted FAT.
	  fs_paths prefix whitelist bound from manifest at load time.

config TS_HAL_FS_PATHS_MAX
	int "ts-fs: fs_paths whitelist CSV capacity (bytes)"
	depends on TS_HAL_FS
	default 256
	help
	  Source: DEC-47 (MD1.2e). Semicolon-separated absolute prefixes.

if TS_HAL

config TS_HAL_MAX_INSTANCES
	int "Max peripheral instances"
	default 24
	help
	  Source: DEC-27 #7 (LLD-ts-hal §6).

config TS_HAL_INPUT_POLL_MS
	int "Input poll period in ms"
	default 100
	help
	  Source: DEC-27 #14 (LLD-ts-hal §6, DR-02).

endif # TS_HAL

config TS_APPMGR
	bool "ts-appmgr: APP lifecycle / package / slot / WAMR host"
	depends on TS_STORE
	default y
	help
	  design/LLD-ts-appmgr.md (M2b). WAMR runtime binding = M2b.2.

if TS_APPMGR

config TS_APP_WAMR
	bool "WAMR wasm runtime (WAMR-2.4.5 pinned)"
	default y
	help
	  DEC-17 WAMR / DEC-25 fast interp + WASI off / DEC-31 no app threads.
	  Wiring batch complete (boot step 8 loads from active slot). Source
	  root injected via env TS_WAMR_DIR (repo carries no third-party
	  source; same discipline as zenoh-pico, dev-environment.md).

config TS_APP_LOAD_MAX
	int "Boot APP load buffer (bytes)"
	depends on TS_APP_WAMR
	default 16384
	help
	  Structural cap for wasm bytes loaded from slot at boot (must stay
	  <= TS_STORE_SLOT_SIZE; board porting revisits per APP size class).

config TS_APP_WAMR_HEAP
	int "WAMR global heap pool size (bytes)"
	depends on TS_APP_WAMR
	default 262144
	help
	  Source: HLD 4.6 per-board table (DEC-27 #10 dynamic per board).
	  Board-unit-6 correction: the old 64KB "native_sim baseline" was a
	  system-allocator-era artifact (linear memory actually came from the
	  host heap). In true pool mode one linear-memory page alone is 64KB,
	  so 64KB is structurally infeasible; default now matches the DEC-27
	  256KB target (native_sim has host RAM to spare).

config TS_APP_PSRAM_HEAP
	bool "WAMR instance heap in PSRAM (shared multi heap)"
	depends on TS_APP_WAMR && ESP_SPIRAM && SHARED_MULTI_HEAP
	default n
	help
	  HLD 4.6 PSRAM layering discipline (DEC-27): only the APP sandbox
	  (WAMR instance heap) may live in external RAM. Pool buffer injected
	  via wasm_runtime_full_init (zero WAMR patches; esp32s3 registers
	  PSRAM in SMH as SMH_REG_ATTR_EXTERNAL). Off = internal SRAM static
	  pool (native_sim/CI path).

config TS_APP_THREAD_PRIORITY
	int "APP runtime thread priority"
	depends on TS_APP_WAMR
	default 10
	help
	  Source: DEC-43 (below net/sysworkq; wamrdemo experiment baseline).

config TS_APP_THREAD_STACK
	int "APP runtime host thread stack (bytes)"
	depends on TS_APP_WAMR
	default 32768
	help
	  Host-side stack for WAMR interpreter C frames (experiment baseline:
	  framework.wamr/wamrdemo); wasm app stack is separate (manifest mem).

config TS_APP_TICK_MS
	int "APP tick period (ms)"
	depends on TS_APP_WAMR
	default 100
	help
	  Source: DEC-27 (LLD-ts-appmgr 5).

config TS_APP_HEALTH_MS
	int "Health probe period (ms)"
	depends on TS_APP_WAMR
	default 1000
	help
	  Source: DEC-27 (LLD-ts-appmgr 4).

config TS_APP_HEALTH_FAILS
	int "Consecutive health failures to rollback"
	depends on TS_APP_WAMR
	default 3
	help
	  Source: DEC-27 (LLD-ts-appmgr 4).

config TS_APP_INSTR_INIT
	int "WASM instruction budget for app_init call"
	depends on TS_APP_WAMR
	default 1000000
	help
	  Source: DEC-48 (Q-28③). WAMR instruction metering quota; quota
	  exhaustion raises "instruction limit exceeded" and rides the
	  existing health-fail/rollback path (~100-200ms upper bound at
	  board-bench-02 interpreter throughput).

config TS_APP_INSTR_TICK
	int "WASM instruction budget for app_tick/app_evt/health calls"
	depends on TS_APP_WAMR
	default 200000
	help
	  Source: DEC-48 (Q-28③). ~20-40ms upper bound per call at
	  board-bench-02 interpreter throughput; calibrate via bench.

config TS_APP_MBOX_DEPTH
	int "Per-APP event mailbox depth (drop-oldest)"
	depends on TS_APP_WAMR
	default 8
	help
	  Source: DEC-27 #15 (LLD-ts-appmgr 5, DR-14).

endif # TS_APPMGR


config TS_NET
	bool "ts-net: zenoh session / keyspace / publish queue / link monitor"
	depends on TS_CORE
	default y
	help
	  design/LLD-ts-net.md (M3a). Transport seam: logic (keyspace/pubq/
	  session/linkmon) is transport-agnostic; zenoh-pico binding compiled
	  only under TS_NET_ZENOH (tests inject a fake transport).

if TS_NET

config TS_FW_VERSION
	string "Firmware version string (sys get-info; versioning.md §5)"
	default "dev"
	help
	  Release builds inject git describe at build time (versioning.md §5);
	  dev builds show "dev" (provenance: build stamp discipline).

config TS_NET_HB_PERIOD_MS
	int "Heartbeat period in ms (cube send + host monitor basis)"
	default 1000
	help
	  Source: DEC-22 (provisionable; factory default 1000ms).

config TS_NET_HB_MISS_LIMIT
	int "Host heartbeat miss limit (periods) before link-loss"
	default 6
	help
	  Source: DEC-22 (~6s at default period).

config TS_NET_HB_RECOVER
	int "Consecutive host heartbeats required to re-declare link up"
	default 2
	help
	  Source: DEC-27 (hysteresis).

config TS_NET_PUBQ_DEPTH
	int "Publish queue depth (drop-oldest when full)"
	default 8
	help
	  Source: DEC-27 (LLD-ts-net §7).

config TS_NET_TELEM_INTERVAL_MS
	int "Periodic telemetry snapshot interval in ms"
	default 200
	help
	  Source: DEC-27. Consumed by telemetry merge (M3a.2).

config TS_NET_LEASE_TTL_MS
	int "Control lease TTL in ms (lazy expiry on access)"
	default 10000
	help
	  Source: DEC-41 (~link-loss window 6s x1.5 + margin). Lease gates
	  command admission only; never couples to safety states.

config TS_NET_IDEM_CACHE
	int "Idempotent reply cache depth (fixed LRU)"
	default 4
	help
	  Source: DEC-40. Same idem replays the cached reply without
	  re-executing the command (safe retry after network timeout).

config TS_NET_APP_CHUNK_MAX
	int "Max app-chunk payload bytes (deploy upload)"
	default 2048
	help
	  Source: LLD-A06 3 (2KB default, 4KB ceiling from NeuroLink field data).
	  Also sizes the zenoh query request buffer (chunk + envelope margin).

endif # TS_NET

config TS_POWER
	bool "ts-power: controlled power slots / current limiting / power budget"
	depends on TS_HAL
	default y
	help
	  design/LLD-ts-power.md (M3b). Power is output (DEC-03): switching
	  goes through ts_safety_commit only; budget total is read-only from
	  provisioning (contract 10).

if TS_POWER

config TS_POWER_MAX_SLOTS
	int "Power slot registry capacity"
	default 4
	help
	  Source: DEC-27 (LLD-ts-power 5).

endif # TS_POWER

config TS_PERIPH
	bool "ts-periph: peripheral descriptors + hotplug events"
	depends on TS_HAL
	default y
	help
	  design/LLD-ts-periph.md (M3b). Logical-uid vs dt_spec decoupling
	  (DEC-04/DEC-14); DETACH drives channel SAFE_FAULT.

if TS_PERIPH

config TS_PERIPH_MAX_DESCS
	int "Peripheral descriptor capacity"
	default 24
	help
	  Source: DEC-27 (aligned with TS_HAL_MAX_INSTANCES).

endif # TS_PERIPH

config TS_NET_ZENOH
	bool "zenoh-pico transport binding (pin 1.10.1, DR-22)"
	depends on TS_NET && ZENOH_PICO
	default n
	help
	  Requires zenoh-pico Zephyr module in ZEPHYR_EXTRA_MODULES. Link-level
	  liveness refinement (keepalive) lands with M3a.2.



config TS_DRV_GPIO
	bool "ts-safety: real GPIO output backend (board porting)"
	depends on TS_SAFETY && GPIO
	default n
	help
	  Real-machine GPIO write backend (DEC-44 IO latency measurement onwards). Binding = zephyr,user node
	  (uid matches channel uid; io-gpios = output pin); write path = sim record (L4 golden continuity) + register write.
	  Default off (native_sim/CI baseline sim backend).

config TS_DRV_PWM
	bool "ts-safety: real PWM output backend (board porting)"
	depends on TS_SAFETY && PWM
	default n
	help
	  Real-machine PWM write backend (board-9). Binding = zephyr,user node (pwm-uid matches channel uid;
	  pwms = 3-cell spec; pin routing via PWM controller pinctrl). Write path = sim record + pwm_set (ns),
	  packed value low16=permille [0,1000], high16=hz/100 (api enforces hz>=100). Failures counted via
	  ts_drv_pwm_err_count(). Default off (native_sim/CI baseline sim backend).

config TS_DRV_ADC
	bool "ts-hal: real ADC input backend (board porting)"
	depends on TS_HAL && ADC
	default n
	help
	  Real-machine ADC read backend (board-9), input side only (contract 3: no protection layer on inputs).
	  Binding = zephyr,user node (adc-uid matches hal dev uid; io-channels = <&adcN ch>). 12-bit, internal ref,
	  12dB attenuation (ADC_GAIN_1_4); millivolts via Zephyr generic conversion (esp32 driver pre-compensates
	  raw with eFuse calibration). Default off (native_sim/CI stub backend).

endmenu
