	depends on TS_APP_WAMR
	default 100
	help
	  Source: DEC-27 (LLD-ts-appmgr 5).

config TS_APP_HEALTH_MS
	int "Health probe period (ms)"
	depends on TS_APP_WAMR
	default 1000
	help
	  Source: DEC-27 (LLD-ts-appmgr 4).

config TS_APP_HEALTH_FAILS
	int "Consecutive health failures to rollback"
	depends on TS_APP_WAMR
	default 3
	help
	  Source: DEC-27 (LLD-ts-appmgr 4).

config TS_APP_INSTR_INIT
	int "WASM instruction budget for app_init call"
	depends on TS_APP_WAMR
	default 1000000
	help
	  Source: DEC-48 (Q-28③). WAMR instruction metering quota; quota
	  exhaustion raises "instruction limit exceeded" and rides the
	  existing health-fail/rollback path (~100-200ms upper bound at
	  board-bench-02 interpreter throughput).

config TS_APP_INSTR_TICK
	int "WASM instruction budget for app_tick/app_evt/health calls"
	depends on TS_APP_WAMR
	default 200000
	help
	  Source: DEC-48 (Q-28③). ~20-40ms upper bound per call at
	  board-bench-02 interpreter throughput; calibrate via bench.

config TS_APP_THREADS
	bool "True wasm multi-threading (host-orchestrated spawn)"
	depends on TS_APP_WAMR
	default n
	help
	  Source: DEC-55 (Q-37 A, 2026-10-13). Enables WAMR thread-mgr +
	  shared-memory compile flags; APP threads are host-orchestrated
	  via ts_thread_start/ts_thread_join natives (one-shot worker
	  model, per-thread instruction budget armed by the host before
	  the wasm call). Default n keeps DEC-31 semantics (baseline
	  builds unaffected). Threads>1 APPs are exempted from the
	  deterministic-replay contract (contract 9,定点豁免).

config TS_APP_INSTR_THREAD
	int "Per-thread WASM instruction budget (one-shot worker)"
	depends on TS_APP_THREADS
	default 200000
	help
	  Source: DEC-55 (Q-37④). Hard upper bound per spawned thread:
	  quota exhaustion raises "instruction limit exceeded" and the
	  thread terminates (fail-closed; no abort, no lock hold).

config TS_APP_THREAD_WSTACK
	int "Worker thread host stack (bytes)"
	depends on TS_APP_THREADS
	default 8192
	help
	  Source: DEC-55 (M19a). Host stack per spawned worker (wasm call
	  frames land on the host stack on targets without hardware bound
	  checks). Sized like M7c per-instance APP thread stacks.

config TS_APP_MBOX_DEPTH
	int "Per-APP event mailbox depth (drop-oldest)"
	depends on TS_APP_WAMR
	default 8
	help
	  Source: DEC-27 #15 (LLD-ts-appmgr 5, DR-14).

endif # TS_APPMGR


