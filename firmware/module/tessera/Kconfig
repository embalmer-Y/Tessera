config TS_APPMGR
	bool "ts-appmgr: APP lifecycle / package / slot / WAMR host"
	depends on TS_STORE
	default y
	help
	  design/LLD-ts-appmgr.md (M2b). WAMR runtime binding = M2b.2.

if TS_APPMGR

config TS_APPMGR_PENDING_TIMEOUT_MS
	int "F3 install-gate pending timeout (ms, fail-closed)"
	default 60000
	help
	  DEC-62 (Q-46①): with prov v2 lconf=1, activate enters a
	  pending-local-confirm state; on timeout the pending install is
	  cancelled (slot kept, re-push to retry). Headless builds with
	  lconf=0 are unaffected. Test benches may lower this value.

config TS_APP_WAMR
	bool "WAMR wasm runtime (WAMR-2.4.5 pinned)"
	default y
	help
	  DEC-17 WAMR / DEC-25 fast interp + WASI off / DEC-31 no app threads.
	  Wiring batch complete (boot step 8 loads from active slot). Source
	  root injected via env TS_WAMR_DIR (repo carries no third-party
	  source; same discipline as zenoh-pico, dev-environment.md).

config TS_APP_LOAD_MAX
	int "Boot APP load buffer (bytes)"
	depends on TS_APP_WAMR
	default 16384
	help
	  Structural cap for wasm bytes loaded from slot at boot (must stay
	  <= TS_STORE_SLOT_SIZE; board porting revisits per APP size class).
	  CG4 (Q-39⑤/Q-42 · DEC-59): a board opts into the "large" APP tier by
	  raising this to >= TS_APP_SIZE_GATE_LARGE (slot size likewise —
	  device capability is derived from this value, no separate switch).

config TS_APP_SIZE_GATE_SMALL
	int "wasm size gate, small tier (bytes)"
	depends on TS_APP_WAMR
	default 16384
	help
	  Source: DEC-27 #6 / Q-39⑤ / Q-42 (DEC-59): 16KB kept for tier=small
	  (v1 packages default to small — zero behavior change).

config TS_APP_SIZE_GATE_LARGE
	int "wasm size gate, large tier (bytes)"
	depends on TS_APP_WAMR
	default 262144
	help
	  Source: Q-39⑤/Q-42 (DEC-59; AG7 measurements: resource-type wasm =
	  payload + ~147B overhead, linear 8-512KB spectrum; 256KB covers
	  font-grade UI resources + complex logic). Boards may tighten; the
	  install-time match rejects tier=large when TS_APP_LOAD_MAX falls
	  short of this value (small-only device).

config TS_APP_WAMR_HEAP
	int "WAMR global heap pool size (bytes)"
	depends on TS_APP_WAMR
	default 262144
	help
	  Source: HLD 4.6 per-board table (DEC-27 #10 dynamic per board).
	  Board-unit-6 correction: the old 64KB "native_sim baseline" was a
	  system-allocator-era artifact (linear memory actually came from the
	  host heap). In true pool mode one linear-memory page alone is 64KB,
	  so 64KB is structurally infeasible; default now matches the DEC-27
	  256KB target (native_sim has host RAM to spare).

config TS_APP_PSRAM_HEAP
	bool "WAMR instance heap in PSRAM (shared multi heap)"
	depends on TS_APP_WAMR && ESP_SPIRAM && SHARED_MULTI_HEAP
	default n
	help
	  HLD 4.6 PSRAM layering discipline (DEC-27): only the APP sandbox
	  (WAMR instance heap) may live in external RAM. Pool buffer injected
	  via wasm_runtime_full_init (zero WAMR patches; esp32s3 registers
	  PSRAM in SMH as SMH_REG_ATTR_EXTERNAL). Off = internal SRAM static
	  pool (native_sim/CI path).

config TS_APP_PSRAM_LOAD_BUF
	bool "Boot APP load buffer in PSRAM (shared multi heap)"
	depends on TS_APP_WAMR && ESP_SPIRAM && SHARED_MULTI_HEAP
	default n
	help
	  K5 (plan 11f): large-tier boards raise TS_APP_LOAD_MAX to >=
	  TS_APP_SIZE_GATE_LARGE (256KB class) — a DRAM static buffer of that
	  size is infeasible on constrained boards. Same HLD 4.6 sandbox-
	  domain discipline as TS_APP_PSRAM_HEAP (the wasm loader rewrites
	  the buffer in place — lesson 35 — so it must be writable RAM;
	  external RAM qualifies). Lazy one-shot alloc, resident thereafter
	  (boot load path is single-threaded).

config TS_APP_PSRAM_VERIFY_BUF
	bool "TSAP verify scratch in PSRAM (shared multi heap)"
	depends on TS_APPMGR && ESP_SPIRAM && SHARED_MULTI_HEAP
	default n
	help
	  K5 (plan 11f): large-tier packages need TS_VERIFY_SCRATCH >= 2x the
	  container (manifest+wasm+COSE overhead) — a 512KB-class DRAM static
	  is infeasible on constrained boards. Same sandbox-domain external-RAM
	  discipline as TS_APP_PSRAM_HEAP/LOAD_BUF (HLD 4.6).

config TS_APP_THREAD_PRIORITY
	int "APP runtime thread priority"
	depends on TS_APP_WAMR
	default 10
	help
	  Source: DEC-43 (below net/sysworkq; wamrdemo experiment baseline).

config TS_APP_THREAD_STACK
	int "APP runtime host thread stack (bytes)"
	depends on TS_APP_WAMR
	default 32768
	help
	  Host-side stack for WAMR interpreter C frames (experiment baseline:
	  framework.wamr/wamrdemo); wasm app stack is separate (manifest mem).

config TS_VERIFY_SCRATCH
	int "TSAP v2 verify scratch buffer (bytes)"
	depends on TS_APPMGR
	default 8704
	help
	  Source: DEC-49 1/2. Holds sig(64) + Sig_structure prefix(24) + COSE
	  embedded payload (= manifest+wasm) during ed25519 verification.
	  Must cover the largest installable package payload (slot size minus
	  header/digest/COSE framing); boards with small packages may lower it.

config TS_APP_TICK_MS
