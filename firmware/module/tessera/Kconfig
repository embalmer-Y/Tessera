config TS_NET_ZENOH
	bool "zenoh-pico transport binding (pin 1.10.1, DR-22)"
	depends on TS_NET && ZENOH_PICO
	default n
	select NET_CONTEXT_RCVTIMEO
	select NET_CONTEXT_SNDTIMEO
	help
	  Requires zenoh-pico Zephyr module in ZEPHYR_EXTRA_MODULES. Link-level
	  liveness refinement (keepalive) lands with M3a.2.

	  RCVTIMEO is a hard requirement (DEC-64(2), R2): zenoh-pico sets
	  SO_RCVTIMEO=100ms on its socket so its single-thread executor keeps
	  rotating between the read/lease/keep-alive futures. Without
	  NET_CONTEXT_RCVTIMEO the option is silently ignored, recv() blocks
	  forever on an inbound stall, the lease task is starved and pico's
	  inbound-lease expiry (auto-reconnect) never fires - the session
	  turns into a permanent one-way zombie (board publishes fine, all
	  queries time out; real-machine reproduced 2026-10-17).

config TS_NET_TLS
	bool "TLS command-plane link (mTLS, DEC-63)"
	depends on TS_NET && TS_NET_ZENOH && ZENOH_PICO_LINK_TLS
	default n
	help
	  zenoh tls/<ip>:<port> locator with prov v2 TLS triple (tls_ca/tls_cert/
	  tls_key DER, 15-pair schema). Client mTLS: CA verify (VERIFY_REQUIRED,
	  server cert SAN must match locator host) + device certificate
	  presentation. Requires ZENOH_PICO_LINK_TLS (repo-carried patch
	  ext/zenoh-pico-tls.patch, DEC-63-1) and CONFIG_MBEDTLS in the app.
	  Default off = zero footprint; TLS-off prov (<=12 pair) byte-identical
	  on any build.



config TS_DRV_GPIO
	bool "ts-safety: real GPIO output backend (board porting)"
	depends on TS_SAFETY && GPIO
	default n
	help
	  Real-machine GPIO write backend (DEC-44 IO latency measurement onwards). Binding = zephyr,user node
	  (uid matches channel uid; io-gpios = output pin); write path = sim record (L4 golden continuity) + register write.
	  Default off (native_sim/CI baseline sim backend).

config TS_DRV_PWM
	bool "ts-safety: real PWM output backend (board porting)"
	depends on TS_SAFETY && PWM
	default n
	help
	  Real-machine PWM write backend (board-9). Binding = zephyr,user node (pwm-uid matches channel uid;
	  pwms = 3-cell spec; pin routing via PWM controller pinctrl). Write path = sim record + pwm_set (ns),
	  packed value low16=permille [0,1000], high16=hz/100 (api enforces hz>=100). Failures counted via
	  ts_drv_pwm_err_count(). Default off (native_sim/CI baseline sim backend).

config TS_DRV_ADC
	bool "ts-hal: real ADC input backend (board porting)"
	depends on TS_HAL && ADC
	default n
	help
	  Real-machine ADC read backend (board-9), input side only (contract 3: no protection layer on inputs).
	  Binding = zephyr,user node (adc-uid matches hal dev uid; io-channels = <&adcN ch>). 12-bit, internal ref,
	  12dB attenuation (ADC_GAIN_1_4); millivolts via Zephyr generic conversion (esp32 driver pre-compensates
	  raw with eFuse calibration). Default off (native_sim/CI stub backend).

config TS_LOG_RATE_PER_S
	int "ts-hal: log rate budget (lines per second, global window)"
	depends on TS_HAL
	default 20
	help
	  V0.4.0 M2 (IR-16): global window budget for ts_log_write (console spam bound;
	  per-app fair-share arrives with multi-APP M7). Over-budget calls return TS_E_BUSY
	  (visible backpressure) and one notice line per burst window.

config TS_HAL_INPUT_EDGE
	bool "ts-hal: GPIO input edge-triggered mode (DR-02, V0.4.0 M5)"
	depends on TS_DRV_GPIO
	default n
	help
	  Edge callbacks do NOT publish events directly (contract 9 single publish path):
	  they only trigger an immediate input-monitor re-poll via a debounced work item
	  (acceleration, not bypass; serialized with the periodic poll on sysworkq).
	  Requires zephyr,user node with gpio-in-uid + in-gpios. ADC stays polled
	  (analog sampling is inherently periodic); GPIO_IN level reads shared by both.

config TS_HAL_INPUT_DEBOUNCE_MS
	int "ts-hal: GPIO input edge debounce (ms)"
	depends on TS_HAL_INPUT_EDGE
	default 10
	help
	  Delay between edge interrupt and the immediate re-poll (contact debounce bound).

config TS_DRV_ES8311
	bool "ts-hal: ES8311 full-codec audio in/out backend (V0.9.0 K2, Q-44/DEC-61)"
	depends on TS_HAL
	default n
	help
	  ES8311 codec over I2C (i2c0 @0x18) + I2S0 standard-Philips master
	  (32-bit slots -> BCLK 1.024MHz; codec derives MCLK from SCLK per
	  board constraint "SCLK must be >1MHz"). Provides BOTH capture
	  (pcm16 640B frames, av pcm16 semantics) and playback (ts_av_write
	  new output face, av:write perm). Requires zephyr,user pins
	  es8311-{bck,ws,sdout,sdin}-gpios. Board: ATK DNESP32-S3B V1.1.

config TS_DRV_PDM
	bool "ts-hal: PDM microphone input backend (V0.4.x M17b, Q-36/DEC-54②)"
	depends on TS_HAL && SOC_ESP32S3
	default n
	help
	  MP34DT05 PDM mic capture via I2S0 PDM RX (i2s_ll register-level, zero
	  upstream patches) + GDMA ring descriptors + polled frame fetch. Requires
	  the ts_pdm_pins DT node (pinctrl: I2S0_I_SD_GPIO41 data-in,
	  I2S0_I_WS_GPIO42 clk-out with output-enable). pcm16 format (16kHz mono
	  16-bit, 640B frames) is dispatched from ts_av_capture. Board bring-up
	  iteration knobs: bck_div (PDM CLK = mclk/bck_div) and PDM DSR.

config TS_STORE_KV
	bool "ts-store: APP state kv persistence (V0.4.0 M9, DR-15)"
	depends on TS_STORE
	default n
	help
	  Per-APP bounded state blob (<=250B) surviving upgrade/rollback, keyed by
	  app_id hash (DR-15). 8KB two-page ping-pong (15 slots x 264B per page),
	  compaction keeps the latest blob per app (bounded to 15 apps, oldest
	  dropped). Flash builds require the ts_kv_part DT node (build-time
	  fail-closed); natives ts_kv_save/ts_kv_load gated by the kv perm class.

config TS_STORE_TRUST
	bool "ts-store: developer trust-root table (V0.8.0 EC2, Q-43/DEC-60)"
	depends on TS_STORE
	default n
	help
	  TUF-root-style full-replacement trust table (map{"ver","keys[]"}),
	  8KB two-copy (2x4KB) ping-pong partition (ts_trust_part, BUILD_ASSERT on
	  flash builds). Effective verification set = factory roots (prov
	  pk0+pk1 / fixed test root in TEST builds) UNION table keys; updates
	  via sys/trust-update (COSE_Sign1 signed by any current effective
	  key, strictly ver N+1 - offline revocation, monotonic anti-rollback).
	  Disabled or absent partition = factory-roots-only = byte-identical
	  V0.7 behavior (existing boards need no re-flash).

config TS_TRUST_TABLE_MAX
	int "Max trust-table CBOR bytes (schema walk ceiling)"
	depends on TS_STORE_TRUST
	default 512
	help
	  Source: Q-43 structural ceiling. Actual worst case is 270B (2 pairs
	  + ver + 8x32B keys); 512 leaves headroom for future additive keys.

config TS_INTERACT
	bool "Local UART interaction terminal (ts shell command set)"
	depends on TS_APPMGR && TS_SAFETY
	default n
	help
	  Source: DEC-65 (R5, owner directive 2026-10-18). Single UART carries
	  logs + app output + interactive terminal (Linux serial-console
	  shape; Zephyr SHELL + SHELL_LOG_BACKEND + LOG_PRINTK). Thin command
	  layer over existing framework entry points (appmgr pending gate,
	  safety arb/clear) - no new safety or network face; the shell is a
	  physical-presence proxy at the same trust level as the BOOT key.
	  Default n = baseline builds byte-identical. SHELL/LOG are optional
	  build faces: core logic (twister-testable) compiles without them;
	  the shell command table is compiled when SHELL is present.

config TS_INTERACT_LOG_LEVEL
	int "ts-interact module log level (0=off 1=err 2=wrn 3=inf 4=dbg)"
	depends on TS_INTERACT
	default 3
	help
	  Source: DEC-65 (module default INF; runtime tunable via `ts log`).

endmenu
