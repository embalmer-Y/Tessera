 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Osptek ESP32-P4C5 Core Board (HP core) — ESP32-P4 + ESP32-C5 companion.
 * Adapted from in-tree waveshare/esp32p4_wifi6_dev_kit (same P4 SoC family).
 * Board facts (osptek docs + esptool probe 2026-10-30): 16MB NOR flash,
 * 32MB embedded PSRAM, CH343 USB-UART bridge on UART0 (GPIO37/38),
 * ESP32-P4 rev v3.2. No on-board LED/buttons (88-pin stamp core board).
 * TODO(companion): ESP32-C5 (SDIO + reset GPIO) bring-up needs the C5
 * connection diagram (c5-p4-connection.png) and C5 slave firmware —
 * deferred; wifi/bt surfaces stay disabled until then.
 */

/dts-v1/;

#include <espressif/esp32p4/esp32p4_rev3.dtsi>
#include "esp32p4c5_core_board_esp32p4_hpcore-pinctrl.dtsi"
#include <espressif/partitions_0x2000_default_16M.dtsi>

/ {
	model = "Osptek ESP32-P4C5 Core Board HP Core";
	compatible = "osptek,esp32p4c5-core-board";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		watchdog0 = &wdt0;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(32)>;
};

/* v3.x silicon: valid CPU frequencies are 100/200/400 MHz */
&cpu0 {
	clock-frequency = <DT_FREQ_M(400)>;
};

&cpu1 {
	clock-frequency = <DT_FREQ_M(400)>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&dma {
	status = "okay";
};

&dma_axi {
	status = "okay";
};

&sdhc {
	sdhc1: sdhc@1 {
		status = "disabled";
		/* ESP32-C5 companion (SDIO + IO) — pins per c5-p4-connection.png
		 * unconfirmed; enable with C5 slave firmware in a follow-up batch. */
	};
};

&usb_serial {
	status = "disabled";
};
