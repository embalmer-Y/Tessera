/*
 * framework.store flash 变体（板级五）：native_sim sim-flash 上定义 ts-store
 * 分区。分区尺寸与 Kconfig 硬耦合（part.c BUILD_ASSERT 把关）：slot =
 * CONFIG_TS_STORE_SLOT_SIZE（native_sim 默认 256KB）；meta 8KB → 副本步距
 * 4096 = flash 擦除块对齐（esp32s3 同布局语义）。
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		ts_prov_part: partition@0 {
			label = "ts-prov";
			reg = <0x00000000 0x1000>;
		};
		ts_meta_part: partition@1000 {
			label = "ts-meta";
			reg = <0x00001000 0x2000>;
		};
		ts_slot_a_part: partition@3000 {
			label = "ts-slot-a";
			reg = <0x00003000 0x40000>;
		};
		ts_slot_b_part: partition@43000 {
			label = "ts-slot-b";
			reg = <0x00043000 0x40000>;
		};
		ts_noinit_part: partition@83000 {
			label = "ts-noinit";
			reg = <0x00083000 0x1000>;
		};
		/* DEC-52①（V2-2）：审计 flash 环 8KB（两页 × 4KB × 64 槽 × 64B） */
		ts_audit_part: partition@84000 {
			label = "ts-audit";
			reg = <0x00084000 0x2000>;
		};
	};
};
