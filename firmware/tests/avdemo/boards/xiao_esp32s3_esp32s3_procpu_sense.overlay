/*
 * avdemo（MD1.2h）：WiFi 使能（avbench 同款——Sense 板变体 DT 自带
 * 摄像头 chosen/SD）+ ts-store flash 五分区 + esp32s3 硬件看门狗（DEC-48）。
 */

&wifi {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

/ {
	chosen {
		zephyr,watchdog = &wdt0;
	};
};

/delete-node/ &slot1_partition;

&flash0 {
	partitions {
		ts_prov_part: partition@170000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-prov";
			reg = <0x170000 0x1000>;
		};
		ts_meta_part: partition@171000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-meta";
			reg = <0x171000 0x2000>;
		};
		ts_slot_a_part: partition@173000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-a";
			reg = <0x173000 0x4000>;
		};
		ts_slot_b_part: partition@177000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-b";
			reg = <0x177000 0x4000>;
		};
		ts_noinit_part: partition@17b000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-noinit";
			reg = <0x17b000 0x1000>;
		};
	};
};
