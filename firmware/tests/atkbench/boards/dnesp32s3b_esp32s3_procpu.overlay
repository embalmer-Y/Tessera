/*
 * K1：ATK DNESP32-S3B V1.1（dnesp32s3b 目标）。板事实 = owner 原理图/
 * 引脚表（/home/emb/docs/atk_dnesp32s3B，仓外）+ 树内板文件核实：
 * 16MB flash（AMP 16M 布局——与 xiao 的 4M 式布局不同，slot1 =
 * 0x5F0000..0xBC0000）、8MB 八线 PSRAM、WiFi、console uart0（经 CH340）。
 * ts-store 分区 carved 自 slot1 空闲区（boot/sys/slot0/appcpu/lpcore/
 * storage 原样保留，esptool 偏移零变化）；4KB 对齐 = esp32s3 擦除块；
 * 尺寸耦合 slot = CONFIG_TS_STORE_SLOT_SIZE（part.c BUILD_ASSERT 把关）。
 * K3 前置一步到位：ts_trust 8KB（双副本 2×4KB——Q-43③）。
 * 板载 LEDB = IO4（PWM demo 判据绑定——deploybench 同型）。
 */
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

&wifi {
	status = "okay";
};

&pinctrl {
	ak_ledc0: ak_ledc0 {
		group1 {
			pinmux = <LEDC_CH0_GPIO4>;
			output-enable;
		};
	};

	/* K4（SD = 板载 TF 槽 @ SPI2——引脚分配表：SCK=IO7/MISO=IO15/
	 * MOSI=IO16/CS=IO17；dsdbench 同型 sdhc-spi-slot） */
	ak_spi2_sd: ak_spi2_sd {
		group1 {
			pinmux = <SPIM2_SCLK_GPIO7>,
				 <SPIM2_MOSI_GPIO16>;
			output-enable;
		};
		group2 {
			pinmux = <SPIM2_MISO_GPIO15>;
			input-enable;
			bias-pull-up;
		};
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ak_ledc0>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&spi2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&ak_spi2_sd>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

	ak_sdcard: sdcard@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};

		spi-max-frequency = <20000000>;
	};
};

/delete-node/ &slot1_partition;

/* 真硅 8MB（esptool 实测 gd 8192k；板文件 16M 声明 = 镜像头 16M——
 * esptool 刷写警告 + 引导日志 "Detected size(8192k) smaller than header
 * (16384k). Probe failed"。K1 期增量构建曾以仓外状态正常引导（该构建目录
 * 已随 /tmp 清理丢失）；8MB 修正后引导停滞未解——见 plan v1.103 阻断登记）。 */
&flash0 {
	reg = <0x0 0x800000>;

	partitions {
		ts_prov_part: partition@5f0000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-prov";
			reg = <0x5f0000 0x1000>;
		};
		ts_meta_part: partition@5f1000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-meta";
			reg = <0x5f1000 0x2000>;
		};
		/* K5（large 档）：槽统一 512KB（COSE 内嵌载荷副本 = 包 ≈2×wasm——256KB wasm 上限需 512KB 槽）（GATE_LARGE 同级——LOAD_MAX 同步
		 * 262144 + PSRAM 装载缓冲；既有 32KB 槽池布局重排，prov/meta
		 * 原位不动〔存量 trust/kv/noinit 内容随重刷重建〕） */
		ts_slot_a_part: partition@5f3000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-a";
			reg = <0x5f3000 0x80000>;
		};
		ts_slot_b_part: partition@673000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-b";
			reg = <0x673000 0x80000>;
		};
		/* 双实例槽池（Q-32②）：entry1 双槽乒乓对 {2,3} */
		ts_slot_c_part: partition@6f3000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-c";
			reg = <0x6f3000 0x80000>;
		};
		ts_slot_d_part: partition@773000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-d";
			reg = <0x773000 0x80000>;
		};
		ts_noinit_part: partition@7f3000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-noinit";
			reg = <0x7f3000 0x1000>;
		};
		/* APP 状态 kv 8KB（DR-15） */
		ts_kv_part: partition@7f4000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-kv";
			reg = <0x7f4000 0x2000>;
		};
		/* K3（Q-43③）：信任根表 8KB（双副本 2×4KB 乒乓） */
		ts_trust_part: partition@7f6000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-trust";
			reg = <0x7f6000 0x2000>;
		};
		/* fw-b：未来 MCUmgr 固件第二 slot 预留（DEC-23；V1 未接线） */
		fw_b_part: partition@7f8000 {
			label = "fw-b";
			reg = <0x7f8000 0x3c8000>;
		};
	};
};

/* K2：ES8311 音频四引脚（owner V1.1 引脚表：BCK=21/WS=13/SDOUT=14/SDIN=47）
 * + XL9555 禁用（SPK_EN 裸 I2C 驱动——pca9555 驱动缓存互踩规避）。
 * F3-1 连带：lcd_bl regulator 节点也引用 io_expander——背光同走裸 I2C
 * （ui_lcd.c：XL9555 OP0=0x02/CF0=0x06 bit7 高有效），节点随之禁用。 */
&io_expander {
	status = "disabled";
};

&lcd_bl {
	status = "disabled";
};

/ {
	zephyr,user {
		/* PWM 后端绑定（板级九模式）：uid 匹配通道逻辑名 */
		pwm-uid = "akpwm";
		pwms = <&ledc0 0 1000000 0>;
		/* ES8311 I2S 面（es8311.c 消费——pdm.c 同族 DT 纪律） */
		es8311-bck-gpios = <&gpio0 21 0>;
		es8311-ws-gpios = <&gpio0 13 0>;
		es8311-sdout-gpios = <&gpio0 14 0>;
		es8311-sdin-gpios = <&gpio0 47 0>;
	};
};
