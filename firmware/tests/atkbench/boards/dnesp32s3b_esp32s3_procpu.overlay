/*
 * K1：ATK DNESP32-S3B V1.1（dnesp32s3b 目标）。板事实 = owner 原理图/
 * 引脚表（/home/emb/docs/atk_dnesp32s3B，仓外）+ 树内板文件核实：
 * 16MB flash（AMP 16M 布局——与 xiao 的 4M 式布局不同，slot1 =
 * 0x5F0000..0xBC0000）、8MB 八线 PSRAM、WiFi、console uart0（经 CH340）。
 * ts-store 分区 carved 自 slot1 空闲区（boot/sys/slot0/appcpu/lpcore/
 * storage 原样保留，esptool 偏移零变化）；4KB 对齐 = esp32s3 擦除块；
 * 尺寸耦合 slot = CONFIG_TS_STORE_SLOT_SIZE（part.c BUILD_ASSERT 把关）。
 * K3 前置一步到位：ts_trust 8KB（双副本 2×4KB——Q-43③）。
 * 板载 LEDB = IO4（PWM demo 判据绑定——deploybench 同型）。
 */
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

&wifi {
	status = "okay";
};

&pinctrl {
	ak_ledc0: ak_ledc0 {
		group1 {
			pinmux = <LEDC_CH0_GPIO4>;
			output-enable;
		};
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ak_ledc0>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/delete-node/ &slot1_partition;

&flash0 {
	partitions {
		ts_prov_part: partition@5f0000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-prov";
			reg = <0x5f0000 0x1000>;
		};
		ts_meta_part: partition@5f1000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-meta";
			reg = <0x5f1000 0x2000>;
		};
		ts_slot_a_part: partition@5f3000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-a";
			reg = <0x5f3000 0x8000>;
		};
		ts_slot_b_part: partition@5fb000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-b";
			reg = <0x5fb000 0x8000>;
		};
		/* 双实例槽池（Q-32②）：entry1 双槽乒乓对 {2,3} */
		ts_slot_c_part: partition@603000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-c";
			reg = <0x603000 0x8000>;
		};
		ts_slot_d_part: partition@60b000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-slot-d";
			reg = <0x60b000 0x8000>;
		};
		ts_noinit_part: partition@613000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-noinit";
			reg = <0x613000 0x1000>;
		};
		/* APP 状态 kv 8KB（DR-15） */
		ts_kv_part: partition@614000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-kv";
			reg = <0x614000 0x2000>;
		};
		/* K3（Q-43③）：信任根表 8KB（双副本 2×4KB 乒乓） */
		ts_trust_part: partition@616000 {
			compatible = "zephyr,mapped-partition";
			label = "ts-trust";
			reg = <0x616000 0x2000>;
		};
		/* fw-b：未来 MCUmgr 固件第二 slot 预留（DEC-23；V1 未接线） */
		fw_b_part: partition@618000 {
			label = "fw-b";
			reg = <0x618000 0x5a8000>;
		};
	};
};

/* K2：ES8311 音频四引脚（owner V1.1 引脚表：BCK=21/WS=13/SDOUT=14/SDIN=47）
 * + XL9555 禁用（SPK_EN 裸 I2C 驱动——pca9555 驱动缓存互踩规避） */
&io_expander {
	status = "disabled";
};

/ {
	zephyr,user {
		/* PWM 后端绑定（板级九模式）：uid 匹配通道逻辑名 */
		pwm-uid = "akpwm";
		pwms = <&ledc0 0 1000000 0>;
		/* ES8311 I2S 面（es8311.c 消费——pdm.c 同族 DT 纪律） */
		es8311-bck-gpios = <&gpio0 21 0>;
		es8311-ws-gpios = <&gpio0 13 0>;
		es8311-sdout-gpios = <&gpio0 14 0>;
		es8311-sdin-gpios = <&gpio0 47 0>;
	};
};
